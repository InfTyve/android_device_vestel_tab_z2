# TWRP flags - Vestel V TAB Z2 LTE (EKVATOR)
# <mount point> <fstype> <device> flags=<semicolon separated flags>

/system_root    ext4  /dev/block/mapper/system    flags=display="System";backup=1;flashimg=0
/vendor         ext4  /dev/block/mapper/vendor    flags=display="Vendor";backup=1
/product        ext4  /dev/block/mapper/product   flags=display="Product";backup=1

/data           ext4  /dev/block/platform/bootdevice/by-name/userdata  flags=display="Data";wipeingui;wipeduringfactoryreset;canencryptbackup=1
/cache          ext4  /dev/block/platform/bootdevice/by-name/cache     flags=display="Cache";wipeingui;wipeduringfactoryreset
/metadata       ext4  /dev/block/platform/bootdevice/by-name/md_udc    flags=display="Metadata";wipeingui
/persist        ext4  /dev/block/platform/bootdevice/by-name/persist   flags=display="Persist";backup=1;flashimg=1

/boot           emmc  /dev/block/platform/bootdevice/by-name/boot      flags=display="Boot";backup=1;flashimg=1
/recovery       emmc  /dev/block/platform/bootdevice/by-name/recovery  flags=display="Recovery";backup=1;flashimg=1
/logo           emmc  /dev/block/platform/bootdevice/by-name/logo      flags=display="Logo";backup=1;flashimg=1
/nvram          emmc  /dev/block/platform/bootdevice/by-name/nvram     flags=display="Nvram";backup=1;flashimg=1
/nvdata         emmc  /dev/block/platform/bootdevice/by-name/nvdata    flags=display="Nvdata";backup=1;flashimg=1
/nvcfg          emmc  /dev/block/platform/bootdevice/by-name/nvcfg     flags=display="Nvcfg";backup=1;flashimg=1
/protect_f      emmc  /dev/block/platform/bootdevice/by-name/protect1  flags=display="Protect_f";backup=1;flashimg=1
/protect_s      emmc  /dev/block/platform/bootdevice/by-name/protect2  flags=display="Protect_s";backup=1;flashimg=1
/seccfg         emmc  /dev/block/platform/bootdevice/by-name/seccfg    flags=display="Seccfg";backup=0;flashimg=1
/bootloader     emmc  /dev/block/platform/bootdevice/by-name/lk        flags=display="Bootloader";backup=1;flashimg=1
/bootloader2    emmc  /dev/block/platform/bootdevice/by-name/lk2       flags=display="Bootloader2";backup=1;flashimg=1
/misc           emmc  /dev/block/platform/bootdevice/by-name/para      flags=display="Misc";backup=0;flashimg=1
/dtbo           emmc  /dev/block/platform/bootdevice/by-name/dtbo      flags=display="Dtbo";backup=1;flashimg=1
/odmdtbo        emmc  /dev/block/platform/bootdevice/by-name/odmdtbo   flags=display="Odmdtbo";backup=1;flashimg=1
/vbmeta         emmc  /dev/block/platform/bootdevice/by-name/vbmeta    flags=display="Vbmeta";backup=1;flashimg=1
/vbmeta_system  emmc  /dev/block/platform/bootdevice/by-name/vbmeta_system flags=display="Vbmeta_system";backup=1;flashimg=1
/vbmeta_vendor  emmc  /dev/block/platform/bootdevice/by-name/vbmeta_vendor flags=display="Vbmeta_vendor";backup=1;flashimg=1

/sdcard         auto  /dev/block/mmcblk1p1  flags=display="MicroSD";storage;wipeingui;removable
/usb_otg        auto  /dev/block/sda1       flags=display="USB OTG";storage;wipeingui;removable
