# Android fstab file - Vestel V TAB Z2 LTE (EKVATOR, MT6765/MT8768)
# Format: <src> <mnt_point> <type> <mnt_flags> <fs_mgr_flags>

# Dynamic (logical) partitions inside super
system    /system  ext4  ro  wait,logical,first_stage_mount
vendor    /vendor  ext4  ro  wait,logical,first_stage_mount
product   /product ext4  ro  wait,logical,first_stage_mount

# Physical partitions
/dev/block/platform/bootdevice/by-name/userdata  /data      ext4  noatime,nosuid,nodev,noauto_da_alloc,inlinecrypt  wait,check,quota,reservedsize=128M,formattable,length=-16384
/dev/block/platform/bootdevice/by-name/cache     /cache     ext4  noatime,nosuid,nodev,noauto_da_alloc,discard  wait,check,formattable
/dev/block/platform/bootdevice/by-name/md_udc    /metadata  ext4  noatime,nosuid,nodev,discard  wait,check,formattable
/dev/block/platform/bootdevice/by-name/persist   /persist   ext4  noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc  wait,check,formattable

# Removable storage
/devices/platform/externdevice*  auto  auto  defaults  voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/mt_usb*        auto  vfat  defaults  voldmanaged=usbotg:auto,encryptable=userdata
